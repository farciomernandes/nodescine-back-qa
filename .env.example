# Application Configuration
APP_URL=http://localhost:8088
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
SPRING_APPLICATION_NAME=cineSk

# Database Configuration
DATABASE_HOST=jdbc:postgresql://localhost:5432/cine_sk
DATABASE_USER=postgres
DATABASE_PASS=your_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_CHARSET=UTF-8
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_base64_encoded_here
SPRING_JWT_SECRET_KEY=your_spring_jwt_secret_key_here
SPRING_JWT_EXPIRATION=86400000

# Flyway Configuration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false

# AWS S3 Configuration
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_SECRET_KEY=your_aws_secret_key
AWS_S3_SESSION_TOKEN=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_HEADERS=*
CORS_METHODS=*

# Payment APIs Configuration
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=your_asaas_api_key
ASAAS_WEBHOOK_SECRET=your_asaas_webhook_secret

PAGSEGURO_API_URL=https://sandbox.api.pagseguro.com
PAGSEGURO_API_KEY=your_pagseguro_api_key
PAGSEGURO_WEBHOOK_SECRET=your_pagseguro_webhook_secret

STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Payment Configuration
PAYMENT_BOLETO_EXPIRY_DAYS=3
PAYMENT_FAILURE_URL=http://localhost:8088/payment/failure
PAYMENT_MAX_RETRIES=3
PAYMENT_PENDING_EXPIRY_HOURS=72
PAYMENT_PIX_EXPIRY_HOURS=24
PAYMENT_RETRY_DELAY_HOURS=24
PAYMENT_SCHEDULER_ENABLED=true
PAYMENT_SUCCESS_URL=http://localhost:8088/payment/success
PAYMENT_SYSTEM_ACCOUNT_ID=system-account-default
PAYMENT_SYSTEM_USER_ID=1
PAYMENT_WEBHOOK_BASE_URL=http://localhost:8088/api/payments/webhook

# Webhook Configuration
WEBHOOK_MAX_RETRIES=5

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CINE_SK=DEBUG

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=user_gmail_here
MAIL_PASSWORD=password_gmail_app_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Email Retry Configuration
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000