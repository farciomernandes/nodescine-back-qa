# Application Configuration
APP_URL=http://localhost:8088
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
SPRING_APPLICATION_NAME=cineSk

# Database Configuration
DATABASE_HOST=jdbc:postgresql://localhost:5432/cine_sk
DATABASE_USER=postgres
DATABASE_PASS=your_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA/Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_PROPERTIES_HIBERNATE_CONNECTION_CHARSET=UTF-8
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_SHOW_SQL=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_base64_encoded_here
SPRING_JWT_SECRET_KEY=your_spring_jwt_secret_key_here
SPRING_JWT_EXPIRATION=86400000

# Flyway Configuration
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false

