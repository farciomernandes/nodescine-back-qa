# Payment Configuration
PAYMENT_BOLETO_EXPIRY_DAYS=3
PAYMENT_FAILURE_URL=http://localhost:8088/payment/failure
PAYMENT_MAX_RETRIES=3
PAYMENT_PENDING_EXPIRY_HOURS=72
PAYMENT_PIX_EXPIRY_HOURS=24
PAYMENT_RETRY_DELAY_HOURS=24
PAYMENT_SCHEDULER_ENABLED=true
PAYMENT_SUCCESS_URL=http://localhost:8088/payment/success
PAYMENT_SYSTEM_ACCOUNT_ID=system-account-default
PAYMENT_SYSTEM_USER_ID=1
PAYMENT_WEBHOOK_BASE_URL=http://localhost:8088/api/payments/webhook

# Webhook Configuration
WEBHOOK_MAX_RETRIES=5

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CINE_SK=DEBUG

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=user_gmail_here
MAIL_PASSWORD=password_gmail_app_password_here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

# Email Retry Configuration
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=1000