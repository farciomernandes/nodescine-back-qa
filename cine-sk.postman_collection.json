            }
          }
        },
        {
          "name": "Listar gêneros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/genres",
              "host": ["{{baseUrl}}"],
              "path": ["api", "genres"]
